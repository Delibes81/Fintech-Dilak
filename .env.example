# ── Supabase (Project Settings → API Keys) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Si tu proyecto todavía muestra la "anon key" (empieza con eyJ...), podés usar esta en su lugar:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Los dos únicos usuarios (PRIVADAS: sin NEXT_PUBLIC_, nunca llegan al navegador) ──
# Deben coincidir con los usuarios creados en Supabase → Authentication → Users.
DILAK_USER_1_NAME=Delibes
DILAK_USER_1_EMAIL=email-de-delibes@ejemplo.com
DILAK_USER_2_NAME=Liliana
DILAK_USER_2_EMAIL=email-de-liliana@ejemplo.com
